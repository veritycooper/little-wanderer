# Change this to a fresh randomly generated secret of at least 20 characters.
PET_API_TOKEN=replace-with-a-long-random-private-token
# Allow the public GitHub Pages front end and localhost development.
ALLOWED_ORIGINS=https://veritycooper.github.io,http://localhost:8000,http://127.0.0.1:8000
DATA_DIR=./data

